[Unit]
Description=Research Agent v4 Longevity Research alpha memo publisher
Wants=network-online.target researka-fullraw-search.service
After=network-online.target researka-fullraw-search.service

[Service]
Type=oneshot
WorkingDirectory=/root/Research-Agent-Bot-v4
EnvironmentFile=/root/Research-Agent-Bot-v4/.env
EnvironmentFile=/etc/researka-agent-v4.env
EnvironmentFile=/etc/researka-fullraw.env
Environment=RESEARKA_DATABASE_URL=http://127.0.0.1:8810
ExecStart=/root/Research-Agent-Bot-v4/.venv/bin/python scripts/daily_alpha_publish_cycle.py --domain longevity_research --refresh-candidates --allow-tier2-repair --max-refresh-batches 5 --submit
ExecStopPost=-/root/Research-Agent-Bot-v4/.venv/bin/python scripts/check_alpha_publish_health.py --domains longevity_research,ai_research,business_research,management_research,economics_research,finance_research,marketing_research --expect-published --check-url --sync-pending-decisions --show-next-candidate --write-summary --max-age-minutes 540
# Keep each publish cycle bounded. The cache warmer owns broad backlog refresh;
# the submitter should repair a small candidate window and fail loud if none pass.
TimeoutStartSec=7200
# Retry infra interruptions, but keep deliberate no-publish exit 2 red.
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2
