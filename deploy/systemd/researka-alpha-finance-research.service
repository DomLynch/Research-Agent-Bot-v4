[Unit]
Description=Research Agent v4 Finance Research guarded alpha submit sweep
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Research-Agent-Bot-v4
EnvironmentFile=/root/Research-Agent-Bot-v4/.env
EnvironmentFile=-/etc/researka-agent-v4.env
ExecStart=/root/Research-Agent-Bot-v4/.venv/bin/python scripts/run_business_alpha_sweep.py --domains finance_research --cycles 2 --topics-per-domain 1 --submit-after-consistent-passes 2
SuccessExitStatus=2 3
TimeoutStartSec=2700
