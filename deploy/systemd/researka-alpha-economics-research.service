[Unit]
Description=Research Agent v4 Economics Research guarded alpha submit sweep
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Research-Agent-Bot-v4
EnvironmentFile=/root/Research-Agent-Bot-v4/.env
EnvironmentFile=/etc/researka-agent-v4.env
Environment=TOPIC_DISCOVERY_BUSINESS_FULLRAW_LOCK_WAIT_SECONDS=7200
Environment=TOPIC_DISCOVERY_V5_SWEEP_WAIT_SECONDS=7200
Environment=V5_MEMO_FULL_RAW_SEARCH_BUDGET_SECONDS=7200
Environment=V5_MEMO_FULL_RAW_FOREGROUND_SWEEP_WAIT_SECONDS=7200
ExecStart=/root/Research-Agent-Bot-v4/.venv/bin/python scripts/run_business_alpha_sweep.py --domains economics_research --cycles 1 --topics-per-domain 2 --submit-after-consistent-passes 2
TimeoutStartSec=12600
