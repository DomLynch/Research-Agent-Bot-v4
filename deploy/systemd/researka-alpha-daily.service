[Unit]
Description=Research Agent v4 daily alpha memo publisher
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Research-Agent-Bot-v4
EnvironmentFile=/root/Research-Agent-Bot-v4/.env
EnvironmentFile=/etc/researka-agent-v4.env
ExecStart=/root/Research-Agent-Bot-v4/.venv/bin/python scripts/daily_alpha_publish_cycle.py --refresh-candidates --max-refresh-batches 2 --estimated-cost-usd 5.00 --max-cost-usd 5.00 --submit
TimeoutStartSec=2700
