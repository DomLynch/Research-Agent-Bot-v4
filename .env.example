# ---------------------------------------------------------------------------
# Research Agent Bot v4 — .env.example
# Copy to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------------------

# Writer — MiMo v2.5 Pro (Xiaomi, OpenAI-compatible)
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_TIMEOUT_SEC=300

# Judge + Editor pass — Gemma 4 31B via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=google/gemma-4-31b-it

# Correction loop — judge sends issues back to writer this many times max
WRITER_MAX_RETRIES=2

# Researka Database — internal canonical corpus (source #16)
# Token lives on Brain VPS at /etc/researka-database/env
RESEARKA_DATABASE_URL=https://database.researka.org
RESEARKA_DATABASE_TOKEN=

# External retrieval — optional rate-limit boosters
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
CROSSREF_POLITE_EMAIL=
UNPAYWALL_EMAIL=

# Safety
BOT_ENABLED=true
DAILY_COST_CAP_USD=25.0

# Runs
RUNS_DIR=runs
