__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.env
.DS_Store
.coverage
htmlcov/

# Runtime/generated artifacts. Fresh clones should build or restore runs/
# locally; production keeps runtime data outside git tracking.
runs/

# macOS Finder dedup-on-copy artifacts ("foo 2.json", "main_draft 2.md", etc.).
# Never canonical; have polluted run-dir bundles before.
* 2.*
* [0-9].*
* [0-9][0-9].*

# Harness-local state
.claude/
# Curator-cycle logs + topic-discovery dumps: runtime state regenerated every
# curator/discovery cycle on the VPS — not deliverables (underscore-prefixed,
# same policy as _diagnostics / _daily_ledger above).
runs/_curator_cycles/
runs/_topics_discovery/
